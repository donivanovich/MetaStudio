# ==============================================================================
# MetaStudio Music Downloader — Environment Configuration Example
# Copy this file to `.env` in the repository root and fill in optional keys.
# Never commit `.env` with real credentials.
# ==============================================================================

# --- Backend Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=https://metastudio.donivanovich.dev,http://localhost:3200,http://127.0.0.1:3200,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Media / FFmpeg ---
# Optional absolute path to ffmpeg binary. If empty, auto-detects from PATH or imageio-ffmpeg.
FFMPEG_PATH=
# Preferred MP3 bitrate in kbps (e.g., 192, 256, 320)
AUDIO_MP3_BITRATE=320

# --- Storage & Concurrency ---
# Directory for session-isolated temporary files and cache
TEMP_STORAGE_DIR=backend/tmp
# Persistent storage file for tag assignments and session state
DATA_STORAGE_DIR=backend/data
# Conservative concurrency for batch playlist downloads (1-3 recommended)
PLAYLIST_DOWNLOAD_CONCURRENCY=2
# Max upload size for custom artwork in MB
MAX_ARTWORK_UPLOAD_MB=10
# Max URL requests per minute per client IP
RATE_LIMIT_PER_MINUTE=60

# --- Music Metadata Providers (Optional Credentials) ---
# MusicBrainz (free, no key required; customize User-Agent contact)
MUSICBRAINZ_USER_AGENT=MetaStudio/1.0.0 (https://github.com/donivanovich/MetaStudio)

# Deezer & iTunes/Apple Music public search APIs work without keys.

# Discogs (optional personal access token for higher rate limits & cover search)
DISCOGS_TOKEN=

# --- Frontend ---
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Docker Compose Host Ports ---
# Local dev (docker-compose.yml): default FRONTEND_PORT=8080, BACKEND_HOST_PORT=8000
# Production (docker-compose.prod.yml behind Cloudflare Tunnel): set FRONTEND_PORT=3200 (loopback only; backend stays internal)
FRONTEND_PORT=8080
BACKEND_HOST_PORT=8000
